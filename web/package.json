    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "test:ui": "tsx tests/ui.ts"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",

{
  "name": "ao-horizon-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "extract": "tsx scripts/extract-docs.ts",
    "check": "tsx scripts/extract-docs.ts && tsx scripts/check-data.ts",
    "predev": "npm run extract",
    "dev": "vite",
    "prebuild": "npm run check",
    "build": "tsc -b && vite build",

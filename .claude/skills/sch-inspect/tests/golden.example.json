{
  "description": "Example expectation file for the sch-inspect golden tests. These values belong to one real project (a 2-phase synchronous buck, root Top_hierarchical.kicad_sch). Copy the file, replace the cases with values checked in KiCad for your project, and point KICAD_GOLDEN_EXPECT at the copy.",
  "cases": [
    {
      "name": "instances list the named sheets",
      "command": ["instances"],
      "has_sheet_names": ["Power State", "MCU IOs"]
    },
    {
      "name": "U103 pin 8 reaches R506 pin 1 across sheets, not U103 pin 10",
      "command": ["project-net", "U103", "--pin", "8"],
      "status": "PROJECT_CONNECTIVITY_EVIDENCE",
      "has_pins": [["U103", "8"], ["R506", "1"]],
      "lacks_pins": [["U103", "10"]]
    },
    {
      "name": "U103 pin 1 is on +9V, not GND",
      "command": ["project-net", "U103", "--pin", "1"],
      "status": "PROJECT_CONNECTIVITY_EVIDENCE",
      "has_power": ["+9V"],
      "lacks_power": ["GND"],
      "lacks_pins": [["U103", "9"], ["U103", "11"]]
    },
    {
      "name": "U103 pin 9 is on GND, not +9V",

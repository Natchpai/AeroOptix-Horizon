{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr create *)",
      "Bash(git push *)",
      "Bash(gh pr merge *)"
    ],
    "ask": [
      "Edit(**/*.kicad_sch)",
      "Edit(**/*.kicad_pcb)",
      "Bash(git merge *)"
    ],
    "deny": [
      "Edit(**/*.kicad_wks)",
      "Edit(**/*.wrl)",
      "Edit(**/templates/**)",
      "Read(~/.notebooklm/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_kicad_v2.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

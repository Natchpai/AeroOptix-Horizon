{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Edit(**/*.kicad_sch)",
      "Edit(**/*.kicad_pcb)",
      "Edit(**/*.kicad_pro)",
      "Edit(**/*.kicad_sym)",
      "Edit(**/*.kicad_mod)",
      "Edit(**/*.step)",
      "Edit(**/*.wrl)",
      "Edit(**/*.kicad_wks)",
      "Edit(**/Library/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_kicad.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
